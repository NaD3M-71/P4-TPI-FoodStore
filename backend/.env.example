# Copiar este archivo como .env y completar los valores.
# El archivo .env no se entrega ni se sube al repositorio.

# Base de datos PostgreSQL
DATABASE_URL=postgresql://user:pass@localhost:5432/foodstore_db
# Para desarrollo local tambien se acepta SQLite:
# DATABASE_URL=sqlite:///./foodstore.db

# Clave para firmar el JWT: minimo 32 caracteres.
# Se puede generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend permitido por CORS
FRONTEND_ORIGIN=http://localhost:5173
