# Copiar este archivo como .env y completar los valores.
# El archivo .env NO se entrega ni se sube al repositorio.

# Clave para firmar los JWT: obligatoria, de al menos 32 caracteres.
# Se puede generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=COMPLETAR_CON_UNA_CLAVE_DE_AL_MENOS_32_CARACTERES

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# En produccion, con HTTPS, usar true para que la cookie no viaje sin cifrar.
COOKIE_SECURE=false

# Base de datos. Por defecto se usa SQLite (productos.db).
# Para PostgreSQL (requiere: pip install psycopg2-binary):
# DATABASE_URL=postgresql+psycopg2://USUARIO:CLAVE@localhost:5432/catalogo
