# Requiere sesion: ejecutar primero el login de auth.http (REST Client conserva la cookie)

@baseUrl = http://localhost:8000

### ===================== PREPARACION =====================
### Se crean una categoria y dos productos para poder armar pedidos.
### Se ejecutan de a uno (Send Request). Los ids se toman de las respuestas.

# @name crearCategoria
POST {{baseUrl}}/categorias/
Content-Type: application/json

{
  "nombre": "Comidas para pedidos",
  "descripcion": "Categoria de prueba para pedidos.http"
}

### Producto 1 (precio 1500.50)

# @name crearProducto1
POST {{baseUrl}}/productos/
Content-Type: application/json

{
  "nombre": "Hamburguesa",
  "descripcion": "Hamburguesa completa",
  "precio_base": 1500.50,
  "disponible": true,
  "categoria_ids": [{{crearCategoria.response.body.id}}]
}

### Producto 2 (precio 800)

# @name crearProducto2
POST {{baseUrl}}/productos/
Content-Type: application/json

{
  "nombre": "Gaseosa",
  "descripcion": "Gaseosa 500 ml",
  "precio_base": 800,
  "disponible": true,
  "categoria_ids": [{{crearCategoria.response.body.id}}]
}

### ===================== POST /pedidos =====================

### Crear pedido con dos detalles (201). Total esperado: 2 x 1500.50 + 3 x 800 = 5401.00
# @name crearPedido
POST {{baseUrl}}/pedidos
Content-Type: application/json

{
  "detalles": [
    { "producto_id": {{crearProducto1.response.body.id}}, "cantidad": 2 },
    { "producto_id": {{crearProducto2.response.body.id}}, "cantidad": 3 }
  ]
}

### Crear un segundo pedido con un solo detalle (201)
# @name crearPedido2
POST {{baseUrl}}/pedidos
Content-Type: application/json

{
  "detalles": [
    { "producto_id": {{crearProducto2.response.body.id}}, "cantidad": 1 }
  ]
}

### ===================== GET /pedidos =====================

### Listar pedidos no eliminados (200)
GET {{baseUrl}}/pedidos

### Obtener un pedido con sus detalles (200)
GET {{baseUrl}}/pedidos/{{crearPedido.response.body.id}}

### ===================== PUT /pedidos/{id} =====================

### Cambiar el estado a CONFIRMADO (200)
PUT {{baseUrl}}/pedidos/{{crearPedido.response.body.id}}
Content-Type: application/json

{
  "estado": "CONFIRMADO"
}

### Cambiar el estado a ENTREGADO (200)
PUT {{baseUrl}}/pedidos/{{crearPedido.response.body.id}}
Content-Type: application/json

{
  "estado": "ENTREGADO"
}

### ===================== CASOS DE ERROR 422 =====================

### 422: producto repetido en dos detalles
POST {{baseUrl}}/pedidos
Content-Type: application/json

{
  "detalles": [
    { "producto_id": {{crearProducto1.response.body.id}}, "cantidad": 1 },
    { "producto_id": {{crearProducto1.response.body.id}}, "cantidad": 2 }
  ]
}

### 422: pedido sin detalles
POST {{baseUrl}}/pedidos
Content-Type: application/json

{
  "detalles": []
}

### 422: cantidad menor que 1
POST {{baseUrl}}/pedidos
Content-Type: application/json

{
  "detalles": [
    { "producto_id": {{crearProducto1.response.body.id}}, "cantidad": 0 }
  ]
}

### 422: estado fuera de los permitidos
PUT {{baseUrl}}/pedidos/{{crearPedido.response.body.id}}
Content-Type: application/json

{
  "estado": "EN_CAMINO"
}

### ===================== CASOS DE ERROR 404 =====================

### 404: un detalle referencia un producto inexistente (no se guarda nada)
POST {{baseUrl}}/pedidos
Content-Type: application/json

{
  "detalles": [
    { "producto_id": {{crearProducto1.response.body.id}}, "cantidad": 1 },
    { "producto_id": 99999, "cantidad": 1 }
  ]
}

### Comprobacion del rollback: el listado sigue con los mismos pedidos de antes
GET {{baseUrl}}/pedidos

### 404: pedido inexistente
GET {{baseUrl}}/pedidos/99999

### 404: actualizar un pedido inexistente
PUT {{baseUrl}}/pedidos/99999
Content-Type: application/json

{
  "estado": "CANCELADO"
}

### ===================== DELETE /pedidos/{id} (borrado logico) =====================

### Eliminar el segundo pedido (204)
DELETE {{baseUrl}}/pedidos/{{crearPedido2.response.body.id}}

### 404: el pedido eliminado ya no se puede obtener
GET {{baseUrl}}/pedidos/{{crearPedido2.response.body.id}}

### 404: ni modificar
PUT {{baseUrl}}/pedidos/{{crearPedido2.response.body.id}}
Content-Type: application/json

{
  "estado": "CONFIRMADO"
}

### 404: ni eliminar de nuevo
DELETE {{baseUrl}}/pedidos/{{crearPedido2.response.body.id}}

### El listado ya no incluye el pedido eliminado
GET {{baseUrl}}/pedidos
